<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <%#
    Space Grotesk + Inter are stand-ins, same Figma mockups used —
    swap for Right Grotesk Tight / Neue Montreal Text (font-family names
    below) once those are installed and licensed for web use.
  %>
<% end %>

<%# ============ NAV ============ %>
<nav>
  <div class="brand">
      <%= image_tag "ChairHop_Logo_Mark_Transparent_1000x1000.png", class: "brand-icon", alt: "ChairHop" %>
    <span class="brand-name">ChairHop</span>
  </div>
  <a class="nav-link" href="#for-pros" data-turbo="false">For Professionals</a>
</nav>

<%# ============ HERO ============ %>
<section class="hero">
  <div>
    <p class="eyebrow" data-controller="geo-eyebrow">Launching soon.</p>
    <h1>A better way to book beauty is almost here.</h1>
    <p class="sub">Discover and book trusted, independent hair, nail, and beauty pros — all in one place. We'll let you know the moment we're live.</p>

    <%= render "waitlist_signups/form", waitlist_signup: @client_waitlist_signup, role: "client" %>

    <p class="fine-print">We'll send a quick confirmation email first, then keep you posted on our progress — including the moment we launch.</p>
    <p class="hero-pro-link"><a class="text-link" href="#for-pros" data-turbo="false">I'm a beauty professional →</a></p>
  </div>

  <div class="mascot-showcase">
      <%= image_tag "ChairHop_Logo_Mark_Transparent_1000x1000.png", class: "mascot-large", alt: "ChairHop mascot" %>
  </div>
</section>

<%# ============ CLIENT VALUE PROPS ============ %>
<section style="background:var(--page); padding-top:0;">
  <div class="section-head">
    <p class="eyebrow">For clients</p>
    <h2>Built for how people actually book beauty appointments.</h2>
  </div>
  <div class="card-grid">
    <div class="prop-card">
      <div class="bar"></div>
      <h3>Find your people</h3>
      <p>Browse verified pros by service, distance, and availability — no login wall standing between you and a scroll.</p>
    </div>
    <div class="prop-card">
      <div class="bar"></div>
      <h3>Book in minutes</h3>
      <p>Pick a time, secure it with a deposit, done. Your card stays safely on file for the rest.</p>
    </div>
    <div class="prop-card">
      <div class="bar"></div>
      <h3>Backed by real reviews</h3>
      <p>See ratings and reviews from other clients before you book — plus optional ID verification for extra peace of mind.</p>
    </div>
  </div>
</section>

<%# ============ DIVIDER ============ %>
<div class="divider">
  <svg class="wave" viewBox="0 0 1200 70" preserveAspectRatio="none">
    <path d="M0,0 C300,70 900,70 1200,0 L1200,70 L0,70 Z" fill="#0A0908"/>
  </svg>
  <div class="divider-icon">
   <%= image_tag "ChairHop_Logo_Mark_Transparent_1000x1000.png", alt: "ChairHop" %>
  </div>
</div>

<%# ============ PRO ZONE ============ %>
<section id="for-pros" class="pro-zone" style="padding-top:56px;">
  <div class="section-head">
    <p class="eyebrow on-dark">For professionals</p>
    <h2>Fill your chair. Keep more of what you make.</h2>
    <p>ChairHop handles discovery, booking, and payment — you handle the craft.</p>
  </div>
  <div class="card-grid">
    <div class="prop-card dark">
      <div class="bar"></div>
      <h3>Keep more of your earnings</h3>
      <p>Just 15% on a new client's first visit, capped at $25. Never a cent on repeat bookings — ever.</p>
    </div>
    <div class="prop-card dark">
      <div class="bar"></div>
      <h3>Run your schedule, your way</h3>
      <p>Set your own hours, services, and pricing. You're always in control of your chair.</p>
    </div>
    <div class="prop-card dark">
      <div class="bar"></div>
      <h3>Get paid fast &amp; securely</h3>
      <p>Deposits and balances land straight in your account via Square — no chasing clients for cash.</p>
    </div>
  </div>

  <%= render "waitlist_signups/form", waitlist_signup: @pro_waitlist_signup, role: "professional" %>

  <p class="pro-caption">We'll send a quick confirmation email first, then keep you posted as we get closer to opening up for professionals.</p>
</section>

<%# ============ FOOTER ============ %>
<footer>
  <div class="footer-brand">
   <%= image_tag "ChairHop_Logo_Mark_Transparent_1000x1000.png", class: "brand-icon", alt: "ChairHop" %>
    <span>ChairHop</span>
  </div>
  <div class="footer-links">
    <%= link_to privacy_path do %>
      Privacy Policy
    <% end %>
  </div>
  <div class="copyright">© 2026 ChairHop. Canada &amp; United States.</div>
</footer>
